{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "twohundredk-fde",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-05",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Phase 1a: booking requests are stored in D1. The owner creates the database
  // and replaces the id before deploying. Without the binding, /api/bookings
  // returns 503 and the form falls back to ADPList.
  // "d1_databases": [
  //   { "binding": "DB", "database_name": "twohundredk-bookings", "database_id": "REPLACE_WITH_D1_DATABASE_ID", "migrations_dir": "migrations" }
  // ],
  "vars": {
    "SITE_ORIGIN": "https://twohundredk.com",
    "PRICE_LABEL_LAUNCH": "Monthly · scope agreed",
    "PRICE_LABEL_BUILD": "Monthly · scope agreed",
    "PRICE_LABEL_EMBEDDED": "Monthly · scope agreed"
  }
}
