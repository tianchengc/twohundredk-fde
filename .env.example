# Stripe test secret key; configure as a Worker secret, never commit a real key.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Create monthly recurring prices in Stripe, then set the matching Price IDs.
STRIPE_PRICE_LAUNCH=price_replace_me
STRIPE_PRICE_BUILD=price_replace_me
STRIPE_PRICE_EMBEDDED=price_replace_me

# Must exactly match the amounts/currency/interval configured for each Stripe price.
PRICE_LABEL_LAUNCH=Configure price in Stripe
PRICE_LABEL_BUILD=Configure price in Stripe
PRICE_LABEL_EMBEDDED=Configure price in Stripe

# Optional visible Hermes chat link. This does not connect server-side data flows.
HERMES_CHAT_URL=
